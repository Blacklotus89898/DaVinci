# knowledge-service per-device settings. Copy to knowledge.env (gitignored) in
# the repo root, next to bin/. Both binaries find it from their own location,
# so the MCP registration needs no -e flags:
#   claude mcp add knowledge /path/to/DaVinci/bin/knowledge-service --scope user
# Precedence: process environment (e.g. registration -e flags) > this file >
# defaults. Relative paths here resolve against this file's directory.

# DOCS_PATH=docs            # default: <repo>/docs
# DB_PATH=knowledge.db      # default: <repo>/knowledge.db
LOG_LEVEL=warn

# Semantic search via Ollama (unset = TF-IDF keyword search)
EMBED_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text
# EMBED_URL=http://localhost:11434

# Commit + push every KB write (only while the repo is on KB_GIT_BRANCH)
# KB_GIT_SYNC=1
# KB_GIT_BRANCH=main
